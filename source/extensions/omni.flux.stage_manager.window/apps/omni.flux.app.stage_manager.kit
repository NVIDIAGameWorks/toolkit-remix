[package]
title = "Flux Stage Manager App"

# That makes it browsable in UI with "experience" filter
keywords = ["app"]

[dependencies]
"omni.kit.uiapp" = {}
"omni.flux.stage_manager.window" = {}

# Plugins
"omni.flux.stage_manager.plugin.column" = {}
"omni.flux.stage_manager.plugin.context.usd" = {}
"omni.flux.stage_manager.plugin.filter.usd" = {}
"omni.flux.stage_manager.plugin.interaction.usd" = {}
"omni.flux.stage_manager.plugin.listener.usd" = {}
"omni.flux.stage_manager.plugin.tree.usd" = {}
"omni.flux.stage_manager.plugin.widget.usd" = {}

[settings.app.window]
title = "Flux Stage Manager App"

width = 700
height = 400
x = -1
y = -1

[settings]
# Basic Kit App
################################
app.versionFile = "${app}/../../../VERSION"
app.fastShutdown = true
app.menu.legacy_mode = false
app.menu.compatibility_mode=false

# Register extension folder from this repo in kit
[settings.app.exts]
folders.'++' = ["${app}/../../../exts", "${app}/../../../extscache", "${app}/../exts", "${app}/../extscache", "${kit}/../exts", "${kit}/../extscache"]

[settings.exts."omni.flux.stage_manager.core"]
schema = "${omni.flux.stage_manager.window}/data/tests/json/test_schema.json"



########################################################################################################################
# BEGIN GENERATED PART (Remove from 'BEGIN' to 'END' to regenerate)
########################################################################################################################

# Kit SDK Version: 110.1.1+production.305458.6312fa25.gl

# Version lock for all dependencies:
[settings.app.exts]
enabled = [
	"omni.kit.core.collection-0.2.4",
]

########################################################################################################################
# END GENERATED PART
########################################################################################################################