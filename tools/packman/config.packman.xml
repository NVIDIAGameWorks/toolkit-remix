<!-- New packman transport config requiring Vault for publishing -->
<config remotes="rtx-remix-internal rtx-remix-external cloudfront gtl">
    <remote2 name="rtx-remix-internal">
        <transport actions="download" protocol="https" packageLocation="lspackages.nvidia.com/api/v1/download/rtx-remix-internal/${name}@${version}"/>
        <transport actions="list" protocol="https" packageLocation="lspackages.nvidia.com/api/v1/list/rtx-remix-internal"/>
        <transport actions="upload" protocol="s3" packageLocation="rtx-remix-internal"/>
    </remote2>
    <remote2 name="rtx-remix-external">
        <transport actions="download" protocol="https" packageLocation="d1oqksizpb0e3d.cloudfront.net/${name}@${version}"/>
        <transport actions="list" protocol="https" packageLocation="lspackages.nvidia.com/api/v1/list/rtx-remix-external"/>
        <transport actions="upload" protocol="s3" packageLocation="rtx-remix-external"/>
    </remote2>
    <remote2 name="cloudfront">
        <transport actions="download" protocol="https" packageLocation="d4i3qtqj3r0z5.cloudfront.net/${name}@${version}" />
    </remote2>
	<remote2 name="gtl">
		<transport actions="download list upload" protocol="gtl"/>
	</remote2>
</config>
